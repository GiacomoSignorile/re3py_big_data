BootStrap: docker
From: python:3.8

%labels

%environment
export LC_ALL=C
export PYTHONPATH=/opt/re3py:$PYTHONPATH

%files
    ../re3py /opt/re3py/re3py
    ../experiment /opt/re3py/experiment
    ../requirements.txt /opt/re3py/requirements.txt
    ../setup.py /opt/re3py/setup.py

%post
apt-get update
apt-get install -y libhdf5-dev graphviz locales git
apt-get clean

pip install scikit-learn
pip install numpy
pip install scipy
pip install pandas
pip install py4j

# Install re3py package
cd /opt/re3py
pip install -e .

# Create symlink for rrank compatibility
ln -s /opt/re3py/re3py /opt/re3py/rrank